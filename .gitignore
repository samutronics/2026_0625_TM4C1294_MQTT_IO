# --- CCS / Code Composer Studio build output ---
Debug/
Release/
**/Debug/
**/Release/
.launches/
.ccsproject.bak

# Build artifacts
*.obj
*.o
*.out
*.map
*.lst
*.d
*.dep
*.opt
*.rov.json
*.elf
*.bin
*.hex

# CCS / Theia / Eclipse workspace metadata
.metadata/
RemoteSystemsTempFiles/
.DS_Store
Thumbs.db

# Local CCS user settings that shouldn't be shared
.settings/org.eclipse.*

# --- Tool / editor noise ---
*.swp
*~

# --- Scratch/temp output (serial captures, flash/OTA test logs, etc.) ---
# tools/ itself is tracked (helper scripts); only its temp sink is ignored.
tools/temp/*
!tools/temp/.gitkeep

# --- CC35x1 local Wi-Fi credentials (real SSID/pass never committed; create
#     from platform/cc35x1/wifi_credentials.example.h) ---
/platform/cc35x1/wifi_credentials.h

# --- CC35x1 flash-tool transient output (flash.sh is tracked; its logs are not) ---
/platform/cc35x1/tools/*.log
/platform/cc35x1/tools/*.log.sign
/platform/cc35x1/tools/last_programming_report.txt

# --- Theia/CCS transient session config ---
.theia/

# --- Local Claude/CCS session artifacts (keep project CLAUDE.md & .mcp.json at root) ---
# Ignore .claude by default, but VERSION the reusable, portable project pieces so they
# come along on a fresh clone / another machine. settings.local.json stays local.
.claude/*
!.claude/commands/
!.claude/skills/
!.claude/settings.json
.codex/

# --- CC35x1 SDK example spikes (imported into the CCS workspace for toolchain validation;
#     NOT part of this repo — to be relocated under platform/cc35x1 or removed later) ---
/ble_wifi_provisioning_LP_EM_CC35X1_freertos_ticlang/
/cc35x1_spike/

# --- CC35x1 CCS project (imported from platform/cc35x1/mqtt_io_cc35x1.projectspec;
#     the projectspec is tracked, the generated managed-build project dir is not) ---
/mqtt_io_cc35x1/
# Transient reimport scaffolds left by the renameProject/importProject dance
/mqtt_io_cc35x1_*/
