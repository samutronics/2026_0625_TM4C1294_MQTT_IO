<?xml version="1.0" encoding="UTF-8"?>
<!--
    mqtt_io_cc35x1.projectspec

    CC35x1 (LP-EM-CC35X1 / CC3551E) build of the MQTT-IO gateway firmware.

    Baseline: the three network_terminal infrastructure files (C startup +
    linker script), COPIED from the SDK by absolute path (this projectspec lives
    at repo:/platform/cc35x1/, not the SDK example dir, so the example's original
    "../../" relative paths would not resolve).  The SDK's demo/CLI/iperf/nimble/
    socket sources are intentionally omitted - the port uses the lwIP raw API,
    not the BSD-socket scaffolding those files pull in.

    Everything else is our own source: the SysConfig file and PAL/board files
    from platform/cc35x1/, and the TivaWare-free portable layer from mqtt_io/
    (common/ + root), linked in place via <file action="link"> so the monorepo
    stays single-source (the same mqtt_io/ files the TM4C managed build compiles).

    Include order note: platform/cc35x1 precedes mqtt_io on the -I list so this
    board's board_pins.h wins over the TM4C1294 board_pins.h of the same name.

    Checkpoint progression (see the linked-files block below): B1 = portable core
    + PAL + board_pins link; B2 = config/pal_storage + mqtt/net cluster;
    B3 = httpd/fs/CGI + the real init+tick body.
-->
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="Cortex M.CC35X1E"
            />
        </when>
    </applicability>

    <project
        title="MQTT-IO gateway (CC35x1)"
        name="mqtt_io_cc35x1"
        configurations="Debug"
        toolChain="TICLANG"
        connection="TIXDS110_Connection.xml"
        device="Cortex M.CC35X1E"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="false"
        products="com.ti.SIMPLELINK_WIFI_SDK;com.ti.SIMPLELINK_WIFI_TOOLBOX;sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/lwip/ti_config/lwip-port/osi/include
            -IC:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/platform/cc35x1
            -IC:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/mqtt_io_common
            -IC:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/mqtt_io_common/common
            -IC:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/mqtt_io_common/pal
            -DSNTP_SUPPORT
            -DMBEDTLS_CONFIG_FILE=\&quot;config-hsm.h\&quot;
            -DNVOCMP_SPS_USE_CBC
            -DMBEDTLS_PSA_CRYPTO_CONFIG_FILE=\&quot;config-psa-crypto-hsm.h\&quot;
            -Ofast
            -DCC35XX
            -DDeviceFamily_CC35XX
            -DNVOCMP_POSIX_MUTEX
            -DLWIP_HTTPD=1
            -DLWIP_HTTPD_CGI=1
            -DLWIP_HTTPD_SSI=1
            -DLWIP_HTTPD_SSI_INCLUDE_TAG=0
            -DLWIP_HTTPD_SUPPORT_11_KEEPALIVE=1
            -DLWIP_HTTPD_KEEPALIVE_TIMEOUT=60000
            -DLWIP_HTTPD_SUPPORT_POST=1
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/utils/FWU/headers
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/common/nv
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/mbedtls/include
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/mbedtls/ti/configs
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/mbedtls/ti/port
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/kernel/freertos
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/posix/ticlang
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/freertos/include
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/freertos/portable/GCC/ARM_CM33_NTZ/non_secure
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/net/ble_interface/inc_adapt
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/net/ble_interface/inc_common
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/drivers/net/wifi/wifi_platform/cc35xx/inc_common
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/net/wifi_stack/inc_common
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/drivers/net/wifi/wifi_host_driver/inc_common
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/drivers/net/wifi/wifi_host_driver/inc_adapt
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/lwip/lwip-stack/src/include
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/lwip/lwip-stack/src/apps/http
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/lwip/ti_config/lwip-port/osi/include
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/lwip/lwip-contrib
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/nimble/ti_config/nimble-port/include
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/nimble/ti_config/nimble-port/porting/npl/osi/include
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/nimble/nimble-src/nimble/include
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/nimble/nimble-src/nimble/host/include
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/nimble/nimble-src/nimble/host/services/gap/include
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/nimble/nimble-src/nimble/host/services/gatt/include
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/nimble/nimble-src/nimble/host/services/dis/include
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/nimble/nimble-src/nimble/host/util/include
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/nimble/nimble-src/nimble/transport/include
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/nimble/nimble-src/porting/nimble/include
            -gdwarf-3
            -mcpu=cortex-m33
            -mfloat-abi=hard
            -mfpu=fpv5-sp-d16
            -Wall
        "
        linkerBuildOptions="
            -L${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source
            -Wl,-l${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/lwip/lib/ticlang/lwip.a
            -Wl,-l${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/hostap/lib/ticlang/hostap.a
            -Wl,-l${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/nimble/lib/ticlang/nimble.a
            -Wl,-l${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/net/wifi_stack/lib/ticlang/wifi_stack.a
            -Wl,-l${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/net/ble_interface/lib/ticlang/ble_interface.a
            -Wl,-l${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/drivers/net/wifi/wifi_host_driver/lib/ticlang/wifi_host_driver.a
            -Wl,-l${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/drivers/net/wifi/wifi_platform/cc35xx/lib/ticlang/wifi_platform_cc35xx.a
            -Wl,-l${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/utils/FWU/lib/ticlang/FWU.a
            -Wl,--reread_libs
            -L${PROJECT_BUILD_DIR}/syscfg
            -lti_utils_build_linker.cmd.genlibs
            -Wl,--rom_model
            -Wl,--warn_sections
            -L${CG_TOOL_ROOT}/lib
            -llibc.a
        "
        sysConfigBuildOptions="
            --product ${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/.metadata/product.json
            --product ${COM_TI_SIMPLELINK_WIFI_TOOLBOX_INSTALL_DIR}/.metadata/product.json
            --compiler ticlang
        "
        preBuildStep="&quot;c:\Users\tomik\Workspaces\Workspace2026_0625_TM4C1294_MQTT_IO\platform\cc35x1\tools\prebuild_fs.bat&quot;"
        postBuildStep="set CCS_BUILD=1&amp;&amp; &quot;c:\Users\tomik\Workspaces\Workspace2026_0625_TM4C1294_MQTT_IO\createbin.bat&quot;"
        description="MQTT-IO gateway firmware ported to LP-EM-CC35X1 (CC3551E)">

        <property name="launch.loadSymbolsOnly" value="true"/>
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>

        <!-- ================================================================
             Minimal boot baseline from network_terminal (absolute SDK paths).
             Only the three files needed to boot FreeRTOS: C startup + SysConfig
             + linker script. All CLI/demo/socket/nimble sources are intentionally
             omitted (they pull in BSD-socket scaffolding the port does not use);
             mainThread() is supplied by our own linked main.c below.
             ================================================================ -->
        <file path="C:/ti/simplelink_wifi_sdk_10_10_01_08/examples/rtos/LP_EM_CC35X1/demos/network_terminal/freertos/main_freertos.c" openOnCreation="false" excludeFromBuild="false" action="copy"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/platform/cc35x1/mqtt_io_cc35x1.syscfg" openOnCreation="false" excludeFromBuild="false" action="copy"/>
        <file path="C:/ti/simplelink_wifi_sdk_10_10_01_08/examples/rtos/LP_EM_CC35X1/demos/network_terminal/freertos/ticlang/linker.cmd" openOnCreation="false" excludeFromBuild="false" action="copy"/>

        <!-- OS-interface adaptation (osi_*): the SDK's lwIP NO_SYS=0 port
             (sys_arch.c inside lwip.a) and Wi-Fi stack call the "osi" kernel
             wrapper, implemented in the demo adaptation layer's osi_dpl.c.  It is
             foundational infrastructure (DPL + FreeRTOS shims), not app logic, so
             it is copied from the SDK like main_freertos.c.  Its Report() console
             sink is provided by platform/cc35x1/pal_log.c. -->
        <file path="C:/ti/simplelink_wifi_sdk_10_10_01_08/examples/rtos/LP_EM_CC35X1/demos/network_terminal/adaptation/osi_dpl.c" openOnCreation="false" excludeFromBuild="false" action="copy"/>

        <!-- osi_filesystem.c implements the osi_f* file API the Wi-Fi stack
             (wifi_stack.a) calls, backed by NVOCMP; nvocmp_cc35xx.c is the NV
             driver providing NVOCMP_loadApiPtrs (used both by osi_filesystem.c
             and by our pal_storage.c).  Copied from the SDK demo adaptation. -->
        <file path="C:/ti/simplelink_wifi_sdk_10_10_01_08/examples/rtos/LP_EM_CC35X1/demos/network_terminal/adaptation/osi_filesystem.c" openOnCreation="false" excludeFromBuild="false" action="copy"/>
        <file path="C:/ti/simplelink_wifi_sdk_10_10_01_08/examples/rtos/LP_EM_CC35X1/demos/network_terminal/nvocmp_cc35xx.c" openOnCreation="false" excludeFromBuild="false" action="copy"/>
        <file path="C:/ti/simplelink_wifi_sdk_10_10_01_08/source/ti/common/nv/crc.c" openOnCreation="false" excludeFromBuild="false" action="copy"/>

        <!-- ================================================================
             Repo sources referenced in place (NOT copied) via action="link" -
             the monorepo stays single-source.

             Checkpoint B1: the zero-edit portable core plus the CC35x1 PAL
             backends and this board's pin map, proving common/ + pal +
             platform/cc35x1 compile AND link against the SDK.  main.c provides
             the mainThread() seam (still an idle stub until B3).

             B2 adds config/pal_storage (NVOCMP) and the mqtt/net cluster; B3
             adds httpd/fs/CGI and the real init+tick body.  Files under mqtt_io/
             are the SAME sources the TM4C managed build compiles.
             ================================================================ -->
        <!-- Platform (CC35x1) - entry seam + PAL backends. -->
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/platform/cc35x1/main.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/platform/cc35x1/net_wifi.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/platform/cc35x1/pal_gpio.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/platform/cc35x1/pal_log.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/platform/cc35x1/pal_str.c" openOnCreation="false" excludeFromBuild="false" action="link"/>

        <!-- Portable core (mqtt_io/ root) - TivaWare-free, shared with the TM4C build. -->
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/mqtt_io_common/buildinfo.c" openOnCreation="false" excludeFromBuild="false" action="link"/>

        <!-- din_chain.c / relay_chain.c are COPIED, not linked, on purpose.  They
             #include "board_pins.h", and a quote-include is resolved FIRST from the
             including file's own directory.  Linked in place they sit in mqtt_io/
             next to the TM4C1294 board_pins.h and would pull it in (TivaWare, wrong
             board).  Copied into the project root they have no adjacent board_pins.h,
             so the include falls through to the -I list and picks this board's
             platform/cc35x1/board_pins.h.  The tracked mqtt_io/*.c stay the single
             source of truth; the project copy is a gitignored, re-imported artifact.
             (A cleaner long-term fix is to relocate board_pins.h out of mqtt_io/
             root into each platform dir, but that modifies the shipped TM4C project's
             include paths - deferred.) -->
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/mqtt_io_common/din_chain.c" openOnCreation="false" excludeFromBuild="false" action="copy"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/mqtt_io_common/relay_chain.c" openOnCreation="false" excludeFromBuild="false" action="copy"/>

        <!-- Portable common/ modules (no external stack deps in this subset). -->
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/mqtt_io_common/common/cgifuncs.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/mqtt_io_common/common/input_events.c" openOnCreation="false" excludeFromBuild="false" action="link"/>

        <!-- ================================================================
             Checkpoint B2: config + storage + the MQTT/network cluster.

             mqtt_client.c is now single-source (raw lwIP TCP behind the pal_irq
             critical-section seam + PalLog); pal_irq.c is this board's seam
             backend (HwiP).  config.c persists via pal_storage.c over NVOCMP.
             netbiosns/sntp are raw lwIP UDP.  None of these #include board_pins.h,
             so they link in place with no adjacency hazard.  Threading correctness
             (raw-API calls marshalled onto tcpip_thread) is deferred to B3.
             ================================================================ -->
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/platform/cc35x1/pal_irq.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/platform/cc35x1/pal_storage.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/mqtt_io_common/config.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/mqtt_io_common/mqtt_client.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/mqtt_io_common/common/mqtt_app.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/mqtt_io_common/common/relay_pulse.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/mqtt_io_common/common/output_ctrl.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/mqtt_io_common/common/io_scan.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/mqtt_io_common/common/netbiosns.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/mqtt_io_common/common/sntp_client.c" openOnCreation="false" excludeFromBuild="false" action="link"/>

        <!-- ================================================================
             Checkpoint B3: the lwIP apps/httpd web server.

             httpd.c + fs.c are COPIED from the SDK (LWIP_HTTPD/CGI/SSI enabled
             via the -D flags above; the SDK's prebuilt lwip.a is built with
             httpd off, so no duplicate symbols).  fs.c does
             `#include HTTPD_FSDATA_FILE` (= "fsdata.c"), resolved from its own
             (project-root) directory - so fsdata.c is a project-root COPY with
             excludeFromBuild=true: it is #included into fs.c, never compiled as
             its own translation unit (its non-static file__* arrays would
             otherwise double-define).  fsdata.c is generated from mqtt_io/fs/ by
             platform/cc35x1/tools/makefsdata.py.

             The CGI/SSI *handler* layer (enet_io.c's ~13 CGI + 28 SSI handlers,
             which mix portable config/relay/input logic with TM4C-only OTA and
             LED-animation code) is a later slice - httpd here serves the static
             fs/ image; dynamic handlers + POST land with their PAL seam next.
             ================================================================ -->
        <file path="C:/ti/simplelink_wifi_sdk_10_10_01_08/source/third_party/lwip/lwip-stack/src/apps/http/httpd.c" openOnCreation="false" excludeFromBuild="false" action="copy"/>
        <file path="C:/ti/simplelink_wifi_sdk_10_10_01_08/source/third_party/lwip/lwip-stack/src/apps/http/fs.c" openOnCreation="false" excludeFromBuild="false" action="copy"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/platform/cc35x1/fsdata.c" openOnCreation="false" excludeFromBuild="true" action="copy"/>

        <!-- ================================================================
             Checkpoint B4: the config web UI handler layer.

             webui.c is the shared SSI + CGI handler module extracted from the
             TM4C enet_io.c (single-source): it maps TivaWare ustdlib/UARTStdio
             onto the PAL via three #defines and casts the legacy int32_t/char*
             handler prototypes into the lwIP typedefs.  It includes din_chain.h
             (not board_pins.h), so it links in place with no adjacency hazard.
             pal_sys.c provides PalReboot (Cortex-M33 SYSRESETREQ) for the
             reboot / factory-reset flow; webui_platform.c stubs the OTA chunk
             CGI (/fwchunk.cgi - OTA on CC35x1 is PSA FWU, deferred).
             ================================================================ -->
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/mqtt_io_common/common/webui.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/platform/cc35x1/pal_sys.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/platform/cc35x1/webui_platform.c" openOnCreation="false" excludeFromBuild="false" action="link"/>

        <!-- ================================================================
             Board peripherals + Wi-Fi credential store (platform/cc35x1).
             None of these #include board_pins.h, so they link in place with no
             adjacency hazard (single-source).  buttons.c = physical button GPIO
             handling; temp_sensor.c = onboard temp read; dhcpserver.c = SoftAP
             DHCP; wifi_store.c = Wi-Fi credential persistence (SoftAP provisioning).
             (These were added to the live project after the last projectspec
             update; declared here so reimport reproduces the working build.)
             ================================================================ -->
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/platform/cc35x1/buttons.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/platform/cc35x1/temp_sensor.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/platform/cc35x1/dhcpserver.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="C:/Users/tomik/Workspaces/Workspace2026_0625_TM4C1294_MQTT_IO/platform/cc35x1/wifi_store.c" openOnCreation="false" excludeFromBuild="false" action="link"/>
    </project>
</projectSpec>
